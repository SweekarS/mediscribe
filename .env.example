# ---- AI APIs ----
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: override Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ---- Auth ----
# SKIP_AUTH=True bypasses JWT auth for local dev. Set to False in production.
SKIP_AUTH=True

# ---- Snowflake (RAG) ----
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=your_database_here
SNOWFLAKE_SCHEMA=your_schema_here
SNOWFLAKE_WAREHOUSE=your_warehouse_here

# ---- Django ----
# IMPORTANT: Generate a real secret for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-this-for-production-use-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Production: set a real PostgreSQL connection string
# Local dev: leave blank to use SQLite
DATABASE_URL=

# ---- Redis (required for multi-worker WebSocket support) ----
REDIS_URL=redis://localhost:6379

# ---- CORS (comma-separated frontend origins) ----
# Include your deployed frontend URL and Electron file:// origin for desktop app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- CSRF trusted origins (for production, match your deployed URL) ----
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# ---- Electron Desktop App ----
# Set at Vite build time for the Electron app to know where the backend lives:
# VITE_API_BASE_URL=https://your-deployed-backend.com
